# Copy to .env and edit. Jobbot does not load .env automatically.
# Bash/zsh: set -a; source ./.env; set +a
# Never commit actual secrets.

# Local mode is the default. It can open Chrome on the machine running Jobbot.
# Default provider: ollama. Uncomment these to use OpenAI instead.
# JOBBOT_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Optional Ollama overrides.
# OLLAMA_HOST=http://127.0.0.1:11434
# JOBBOT_MODEL=qwen2.5:7b

# Hosted account mode on Render or Codespaces. The platform supplies the URL.
# A non-empty JOBBOT_MONGODB_URI enables it.
# Leave these commented on the machine you use to fill applications.
# JOBBOT_MONGODB_URI=
# JOBBOT_MONGODB_DB=jobbot
# JOBBOT_DATA_KEY=
# JOBBOT_ACCOUNT_EMAIL=
# JOBBOT_GOOGLE_CLIENT_ID=
# JOBBOT_GOOGLE_CLIENT_SECRET=
# JOBBOT_BIND=0.0.0.0

# Optional. Your hosting provider may supply PORT.
# PORT=8765
