# Copy to .env and edit. ./jobbot.sh ui loads it automatically for the dashboard.
# For other commands, export settings in your shell if needed.
# Never commit actual secrets.

# Default provider: ollama. Uncomment these to use OpenAI instead.
# JOBBOT_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Optional Ollama overrides.
# OLLAMA_HOST=http://127.0.0.1:11434
# JOBBOT_MODEL=qwen2.5:7b

# Hosted account mode on Render or Codespaces. The platform supplies the URL.
# These settings are required for the dashboard. The local CLI does not need them.
# JOBBOT_MONGODB_URI=
# JOBBOT_MONGODB_DB=jobbot
# JOBBOT_DATA_KEY=
# JOBBOT_ACCOUNT_EMAIL=
# JOBBOT_GOOGLE_CLIENT_ID=
# JOBBOT_GOOGLE_CLIENT_SECRET=
# JOBBOT_BIND=0.0.0.0

# Optional. Your hosting provider may supply PORT.
# PORT=8765

# Optional employer login secret for hosted runs. Use a dedicated password.
# JOBBOT_EMPLOYER_PASSWORD=
